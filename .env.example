# ------------------------------------------------------------------
# Sanro AI - environment template
# Copy to .env / .env.local and fill in real values. NEVER commit
# real secrets to the repository.
# ------------------------------------------------------------------

# ---- App -------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Sanro AI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# ---- Database (PostgreSQL) -------------------------------------------------
# Local default uses the postgres superuser created during install.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sanro_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/sanro_test

# ---- Auth ------------------------------------------------------------------
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_EXPIRES_IN=7d
AUTH_REFRESH_EXPIRES_IN=30d
AUTH_ISSUER=sanro-api

# ---- AI --------------------------------------------------------------------
# Server-side only. Never expose to browser / Android client.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=mock

# ---- Storage ---------------------------------------------------------------
# Local dev writes to ./storage. For production use S3-compatible storage.
STORAGE_TYPE=local
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=

# ---- Seed super admin (dev only) -------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@sanroai.com
SEED_SUPER_ADMIN_PASSWORD=Sanro@12345

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# ---- PDF -------------------------------------------------------------------
PDF_ENGINE=chrome
PLAYWRIGHT_BROWSER_PATH=