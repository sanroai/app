# Sanro AI — API environment (example). Copy to .env and fill real values.
# NEVER commit the real .env.

NODE_ENV=development
APP_NAME=Sanro AI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Comma-separated list of allowed CORS origins. Empty = allow all (dev only).
CORS_ORIGINS=

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sanro_dev

# JWT secrets — use long random strings in production (min 32 chars)
AUTH_SECRET=dev-only-secret-change-me-32chars-min
AUTH_TOKEN_EXPIRES_IN=7d
AUTH_REFRESH_EXPIRES_IN=30d
AUTH_ISSUER=sanro-api

# AI provider — set AI_PROVIDER=openai and provide a real key in production
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1

# Storage — local (dev) or s3 (production)
STORAGE_TYPE=local
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# PDF engine — chrome (production) or none
PDF_ENGINE=chrome

# Optional production super admin seed
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=