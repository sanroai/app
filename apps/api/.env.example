# Sanro AI — API environment (example). Copy to .env and fill real values.
# NEVER commit the real .env.

NODE_ENV=development
APP_NAME=Sanro AI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Comma-separated list of allowed CORS origins. Empty = allow all (dev only).
CORS_ORIGINS=

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sanro_dev

# Separate database used by the QA/e2e suite (`pnpm --filter @sanro/api test`)
# and `db:seed:qa`, so the developer database stays clean after a local reset.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/sanro_test

# JWT secrets — use long random strings in production (min 32 chars)
# generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_TOKEN_EXPIRES_IN=7d
AUTH_REFRESH_EXPIRES_IN=30d
AUTH_ISSUER=sanro-api

# AI provider - `mock` (offline, deterministic), `openai` (any OpenAI-compatible
# /chat/completions endpoint) or `gemini` (Google generative language API).
# The key stays inside the API process; never expose it to web/mobile clients.
#   OpenAI: AI_PROVIDER=openai AI_MODEL=gpt-4o-mini AI_BASE_URL=https://api.openai.com/v1
#   Gemini: AI_PROVIDER=gemini AI_MODEL=gemini-3-flash-preview AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Gemini retires model ids for new keys without notice and its model families differ
# by an order of magnitude in latency (measured 2026-10-24 on the same 120-word
# prompt: gemini-3-flash-preview 3.6s, gemini-3.8-flash 18.8s, gemini-flash-latest
# 39.4s). The service therefore retries a 404/429/timeout against
# `gemini-3-flash-preview` and then `gemini-flash-latest`, so a stale or slow
# AI_MODEL degrades instead of breaking or blowing the request timeout.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1

# Storage — local (dev) or s3 (production)
STORAGE_TYPE=local
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# PDF engine — chrome (production) or none
PDF_ENGINE=chrome

# Bootstrap Super Admin created by the SYSTEM seed (`db:seed`).
# Local development only — never reuse these values in production.
SEED_SUPER_ADMIN_EMAIL=admin@sanroai.com
SEED_SUPER_ADMIN_PASSWORD=

# Password for the seeded demo/QA accounts (student@, teacher@, principal@, parent@).
# The seed and the QA scripts read it from here — it is never stored in the repository.
SEED_DEMO_PASSWORD=