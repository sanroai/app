{
  "name": "@sanro/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sanro AI - NestJS backend API",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx prisma/prepare-test-db.ts && tsx prisma/seed.ts --qa && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts --system",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "db:seed:qa": "tsx prisma/seed.ts --qa",
    "db:test:prepare": "tsx prisma/prepare-test-db.ts",
    "reset:local-data": "tsx prisma/reset-local-data.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts --system"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.7.1",
    "@sanro/config": "workspace:*",
    "@sanro/types": "workspace:*",
    "@sanro/validation": "workspace:*",
    "@sentry/nestjs": "^10.74.0",
    "@sentry/profiling-node": "^10.74.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.52.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.23.0",
    "express": "^5.1.0",
    "prisma": "^6.7.1",
    "supertest": "^7.1.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.28.0",
    "@swc/core": "^1.13.0",
    "vitest": "^3.1.1"
  }
}