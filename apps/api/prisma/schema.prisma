// Sanro AI - Prisma schema
// PostgreSQL 18

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum InstitutionType {
  SCHOOL
  COACHING_CENTRE
  COACHING
  ACADEMY
  TUITION_CENTRE
  EDUCATIONAL_INSTITUTE
  TRAINING_CENTRE
  OTHER
  SANRO_PLATFORM
}

enum InstitutionStatusEnum {
  ACTIVE
  SUSPENDED
  EXPIRED
  ARCHIVED
  PENDING
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum AcademicYearStatus {
  ACTIVE
  PREPARING
  COMPLETED
  ARCHIVED
}

enum GroupType {
  CLASS
  DIVISION
  BATCH
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  DEACTIVATED
  ARCHIVED
}

enum ContentType {
  VIDEO
  NOTES
  PDF
  QUIZ
  MODEL_3D
  AR
  GAME
  PRACTICE_SET
  ARTICLE
  IMAGE
  WORKSHEET
  REVISION
  FLASHCARDS
  INTERACTIVE
  EXAMPLE
  READING
  OTHER
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  INSTITUTION_ONLY
  PRIVATE
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  MULTI_SELECT
  FILL_BLANK
  VERY_SHORT_ANSWER
  SHORT_ANSWER
  LONG_ANSWER
  NUMERICAL
}

enum QuestionStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

enum QuestionSource {
  MANUAL
  AI
  IMPORT
  SEED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum PaperStatus {
  DRAFT
  READY
  EXPORTED
  ARCHIVED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AssessmentMode {
  DIGITAL
  PRINT
  BOTH
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum MasteryLevel {
  NEEDS_INTERVENTION
  WEAK
  DEVELOPING
  GOOD
  MASTERED
  INSUFFICIENT_EVIDENCE
}

enum ImportStatus {
  PENDING
  PROCESSING
  VALIDATED
  COMMITTED
  FAILED
}

enum ImportRowStatus {
  VALID
  INVALID
  DUPLICATE
  EXISTING
  SKIPPED
  IMPORTED
}

enum ImportEntityType {
  STUDENTS
  TEACHERS
  PARENTS
  CONTENT
  QUESTIONS
}

enum RemediationPlanStatus {
  ACTIVE
  COMPLETED
}

enum RemediationItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum NotificationEventType {
  ASSESSMENT_ASSIGNED
  ASSESSMENT_DUE
  ASSESSMENT_RESULT
  WEAK_CONCEPT_DETECTED
  REMEDIATION_ASSIGNED
  PRACTICE_ASSIGNED
  RETEST_AVAILABLE
  RETEST_RESULT
  ACHIEVEMENT_UNLOCKED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  WHATSAPP
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
  PAST_DUE
  SUSPENDED
}

enum SubscriptionPlanKey {
  STUDENT_MONTHLY
  STUDENT_YEARLY
  INSTITUTION
}

enum ReportType {
  STUDENT
  CLASS
  TEACHER
  INSTITUTION
  ASSESSMENT
  CONCEPT
  IMPROVEMENT
}

enum AuditAction {
  STUDENT_IMPORTED
  STUDENT_CREATED
  STUDENT_MOVED
  TEACHER_ADDED
  QUESTION_GENERATED
  QUESTION_APPROVED
  PAPER_CREATED
  PAPER_EXPORTED
  ASSESSMENT_PUBLISHED
  RESULT_MODIFIED
  REMEDIATION_ASSIGNED
  INSTITUTION_CREATED
  INSTITUTION_UPDATED
  INSTITUTION_ACTIVATED
  INSTITUTION_SUSPENDED
  INSTITUTION_EXPIRED
  INSTITUTION_ARCHIVED
  INSTITUTION_RESTORED
  INSTITUTION_DELETED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_EXPIRED
  PLAN_CHANGED
  USER_LIMIT_CHANGED
  ADMIN_CHANGED
  INSTITUTION_ADMIN_CHANGED
  USER_DISABLED
  USER_ENABLED
  STUDENT_UPDATED
  STUDENT_DISABLED
  STUDENT_ENABLED
  STUDENT_ARCHIVED
  STUDENT_INSTITUTION_CHANGED
  STUDENT_PARENT_LINKED
  STUDENT_PARENT_UNLINKED
  TEACHER_UPDATED
  TEACHER_DISABLED
  TEACHER_ENABLED
  TEACHER_ARCHIVED
  TEACHER_INSTITUTION_CHANGED
  PARENT_CREATED
  PARENT_UPDATED
  PARENT_DISABLED
  PARENT_ENABLED
  PARENT_ARCHIVED
  PARENT_CHILD_LINKED
  PARENT_CHILD_UNLINKED
  DIRECT_SUBSCRIPTION_CREATED
  DIRECT_SUBSCRIPTION_UPDATED
  DIRECT_SUBSCRIPTION_RENEWED
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTENT_STATUS_CHANGED
  CONTENT_DELETED
  CONTENT_VERSION_RESTORED
  CONTENT_ASSIGNED
  CONTENT_UNASSIGNED
  CONTENT_REVIEWED
  CONTENT_PUBLISHED
  BOOK_UPLOADED
  BOOK_PROCESSING_FAILED
  BOOK_COMPLETED
  CURRICULUM_CREATED
  CURRICULUM_UPDATED
  CURRICULUM_IMPORTED
  CURRICULUM_ASSIGNED
  CURRICULUM_UNASSIGNED
  KNOWLEDGE_BASE_CREATED
  KNOWLEDGE_BASE_DELETED
  YOUTUBE_ADDED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Language {
  EN
  MR
  HI
}

enum ContentProgressState {
  NOT_STARTED
  STARTED
  QUARTER
  HALF
  THREE_QUARTER
  COMPLETED
}

enum UploadEntity {
  DOCUMENT
  VIDEO
  IMAGE
  MODEL_3D
  IMPORT_FILE
  LOGO
  CONFIGURED
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  phone         String?
  name          String
  passwordHash  String?
  isActive      Boolean  @default(true)
  isSuperAdmin  Boolean  @default(false)
  language      Language @default(EN)
  avatarUrl     String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships        InstitutionMember[]
  subscriptions      Subscription[] @relation("DirectSubscriptionOwner")
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  teacher            Teacher?
  student            Student?
  parent             Parent?
  createdInstitutions Institution[] @relation("InstitutionCreatedBy")
  createdPapers      QuestionPaper[] @relation("PaperCreatedBy")
  createdQuestions   Question[]     @relation("QuestionCreatedBy")
  createdAssessments Assessment[]   @relation("AssessmentCreatedBy")
  createdImports     ImportJob[]
  createdPlans       RemediationPlan[] @relation("PlanCreatedBy")
  createdKnowledgeBases KnowledgeBase[] @relation("KnowledgeBaseCreator")
  subscriptionHistoryChanges SubscriptionHistory[] @relation("SubscriptionHistoryChangedBy")

  @@index([email])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  refreshJti String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// TENANCY & INSTITUTIONS
// ============================================================================

model Institution {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  type         InstitutionType
  isSystemInstitution Boolean @default(false)
  status       InstitutionStatusEnum @default(PENDING)
  code         String?  @unique
  logoUrl      String?
  description  String?
  address      String?
  city         String?
  state        String?
  country      String?
  website      String?
  contactPerson String?
  primaryPhone String?
  primaryEmail String?
  seatLimit    Int?
  gracePeriodDays Int    @default(0)
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  archivedAt   DateTime?
  suspendedAt  DateTime?
  expiredAt    DateTime?
  deletedAt    DateTime?
  lastActivityAt DateTime @default(now())

  createdBy      User?               @relation("InstitutionCreatedBy", fields: [createdById], references: [id])
  members        InstitutionMember[]
  academicYears  AcademicYear[]
  groups         Group[]
  students       Student[]
  teachers       Teacher[]
  parents        Parent[]
  questions      Question[]
  papers         QuestionPaper[]
  assessments    Assessment[]
  imports        ImportJob[]
  content        ContentItem[]
  subscriptions  Subscription[]
  subscriptionHistory SubscriptionHistory[]
  supportTickets SupportTicket[]
  reports        Report[]
  auditLogs      AuditLog[]
  knowledgeBases KnowledgeBase[]
  contentAssignments ContentAssignment[]
  curriculumAccess InstitutionCurriculumAccess[]

  @@index([isSystemInstitution])
  @@index([status])
  @@index([type])
  @@index([createdById])
  @@index([deletedAt])
}

model InstitutionMember {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  userId        String   @db.Uuid
  role          Role
  status        MembershipStatus @default(ACTIVE)
  joinedAt      DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([userId])
  @@index([institutionId, role])
}

model AcademicYear {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  name          String
  startDate     DateTime
  endDate       DateTime
  status        AcademicYearStatus @default(PREPARING)
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  groups     Group[]
  students   Student[]
  imports    ImportJob[]
  groupMemberships GroupMembership[]
  teacherAssignments TeacherGroup[]

  @@unique([institutionId, name])
  @@index([institutionId, status])
}

model Group {
  id             String    @id @default(uuid()) @db.Uuid
  institutionId  String    @db.Uuid
  academicYearId String    @db.Uuid
  parentGroupId  String?   @db.Uuid
  name           String
  type           GroupType
  grade          String?
  status         GroupStatus @default(ACTIVE)
  createdAt      DateTime  @default(now())
  archivedAt     DateTime?

  institution  Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  parentGroup  Group?               @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  children     Group[]              @relation("GroupHierarchy")
  memberships  GroupMembership[]
  teacherGroups TeacherGroup[]
  assessmentAssignments AssessmentAssignment[] @relation("AssignmentGroup")

  @@unique([academicYearId, name])
  @@index([institutionId])
  @@index([academicYearId])
  @@index([parentGroupId])
}

model GroupMembership {
  id            String   @id @default(uuid()) @db.Uuid
  groupId       String   @db.Uuid
  studentId     String   @db.Uuid
  academicYearId String  @db.Uuid
  joinedAt      DateTime @default(now())
  leftAt        DateTime?

  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
}

// ============================================================================
// PEOPLE: TEACHERS / STUDENTS / PARENTS
// ============================================================================

model Teacher {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  userId        String   @unique @db.Uuid
  employeeId    String?
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  deactivatedAt DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects    TeacherSubject[]
  groups      TeacherGroup[]
  assessments Assessment[] @relation("AssessmentTeacher")

  @@unique([institutionId, employeeId])
  @@index([institutionId])
  @@index([userId])
}

model TeacherSubject {
  id        String @id @default(uuid()) @db.Uuid
  teacherId String @db.Uuid
  subjectId String @db.Uuid

  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model TeacherGroup {
  id            String @id @default(uuid()) @db.Uuid
  teacherId     String @db.Uuid
  groupId       String @db.Uuid
  academicYearId String @db.Uuid

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, groupId, academicYearId])
  @@index([groupId])
}

model Student {
  id            String        @id @default(uuid()) @db.Uuid
  institutionId String?       @db.Uuid
  academicYearId String?      @db.Uuid
  userId        String?       @unique @db.Uuid
  name          String
  email         String?
  phone         String?
  gender        String?
  dateOfBirth   DateTime?
  rollNumber    String?
  grade         String?
  allGrades     Boolean       @default(false)
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  deactivatedAt DateTime?
  archivedAt    DateTime?

  institution  Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear?    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id])
  groupMemberships GroupMembership[]
  enrolments   StudentEnrolment[]
  parentLinks ParentStudentLink[]
  attempts     AssessmentAttempt[]
  mastery      ConceptMastery[]
  diagnostics  DiagnosticResult[]
  remediationPlans RemediationPlan[]
  practiceSets PracticeSet[]
  contentProgress ContentProgress[]
  gamification GamificationProfile?
  xpEvents     XpEvent[]
  achievements StudentAchievement[]
  assessmentAssignments AssessmentAssignment[]
  flashcardRatings FlashcardRating[]

  @@unique([institutionId, email])
  @@index([institutionId])
  @@index([academicYearId])
  @@index([grade])
}

/// The classes a student is enrolled in.
///
/// Content is grade-scoped, and one student may take more than one class (a
/// class-8 student taking class-9 mathematics, a student repeating a year, a
/// demo account that explores every class). `Student.grade` stays the primary
/// class shown on profiles and reports; every read that authorises content asks
/// `StudentGradeAccessService`, which unions these rows.
model StudentEnrolment {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @db.Uuid
  grade     String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, grade])
  @@index([studentId])
  @@index([grade])
}

model Parent {
  id            String  @id @default(uuid()) @db.Uuid
  institutionId String? @db.Uuid
  userId        String? @unique @db.Uuid
  name          String
  email         String?
  phone         String?
  createdAt     DateTime @default(now())

  institution Institution?      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id])
  studentLinks ParentStudentLink[]

  @@index([institutionId])
  @@index([email])
}

model ParentStudentLink {
  id        String @id @default(uuid()) @db.Uuid
  parentId  String @db.Uuid
  studentId String @db.Uuid

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

// ============================================================================
// CURRICULUM
// ============================================================================

model Board {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  grades    Grade[]
  subjects  Subject[]
  questions Question[]
  content   ContentItem[]
  curriculumAccess InstitutionCurriculumAccess[]

  @@index([active])
}

model Grade {
  id      String @id @default(uuid()) @db.Uuid
  boardId String @db.Uuid
  name    String
  order   Int    @default(0)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, name])
}

model Subject {
  id          String  @id @default(uuid()) @db.Uuid
  boardId     String  @db.Uuid
  code        String
  name        String
  icon        String?
  color       String?
  order       Int     @default(0)
  description String?
  active      Boolean @default(true)

  board      Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  chapters   Chapter[]
  questions  Question[]
  papers     QuestionPaper[]
  assessments Assessment[]
  content    ContentItem[]
  teacherSubjects TeacherSubject[]
  curriculumAccess InstitutionCurriculumAccess[]

  @@unique([boardId, code])
  @@index([boardId])
}

model Chapter {
  id          String @id @default(uuid()) @db.Uuid
  subjectId   String @db.Uuid
  name        String
  code        String
  grade       String
  order       Int    @default(0)
  description String?

  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]
  content   ContentItem[]
  assessments Assessment[]

  @@unique([subjectId, code])
  @@index([subjectId, grade])
}

model Topic {
  id        String @id @default(uuid()) @db.Uuid
  chapterId String @db.Uuid
  name      String
  order     Int    @default(0)

  chapter   Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  concepts  Concept[]
  questions Question[]

  @@unique([chapterId, name])
  @@index([chapterId])
}

model Concept {
  id          String  @id @default(uuid()) @db.Uuid
  topicId     String  @db.Uuid
  name        String
  order       Int     @default(0)
  description String?

  topic      Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions  Question[]
  questionMappings QuestionConcept[]
  mastery    ConceptMastery[]
  diagnostics DiagnosticResult[]
  remediationPlans RemediationPlan[]
  content    ContentItem[]
  practiceSets PracticeSet[]
  flashcardRatings FlashcardRating[]

  @@unique([topicId, name])
  @@index([topicId])
  @@index([name])
}

// ============================================================================
// CONTENT
// ============================================================================

model ContentItem {
  id              String        @id @default(uuid()) @db.Uuid
  type            ContentType
  status          ContentStatus @default(DRAFT)
  visibility      Visibility    @default(INSTITUTION_ONLY)
  title           String
  description     String?
  durationSeconds Int?
  /// Chapter markers of a video lesson: [{ "title": "Total Surface Area", "startSeconds": 2558 }]
  segments       Json?
  thumbnailUrl    String?
  url             String?
  order           Int           @default(0)
  version         Int           @default(1)
  ownerType       ContentOwnerType @default(INSTITUTION)
  directSanroAvailable Boolean  @default(false)
  institutionId   String?       @db.Uuid
  boardId         String?       @db.Uuid
  subjectId       String?       @db.Uuid
  chapterId       String?       @db.Uuid
  topicId         String?       @db.Uuid
  conceptId       String?       @db.Uuid
  grade           String?
  videoId         String?
  storageKey      String?
  sourceType      ContentSourceType?
  language        Language      @default(EN)
  createdById     String?       @db.Uuid
  reviewedById    String?       @db.Uuid
  publishedAt     DateTime?
  archivedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])
  board      Board?          @relation(fields: [boardId], references: [id])
  subject    Subject?        @relation(fields: [subjectId], references: [id])
  chapter    Chapter?     @relation(fields: [chapterId], references: [id])
  concept    Concept?     @relation(fields: [conceptId], references: [id])
  progress   ContentProgress[]
  remediationItems RemediationItem[]
  versions   ContentVersion[]
  assignments ContentAssignment[]

  @@index([institutionId])
  @@index([conceptId])
  @@index([type, status])
  @@index([ownerType, status])
  @@index([ownerType, status, institutionId])
  @@index([grade, subjectId, status])
  @@index([conceptId, order])
  @@index([directSanroAvailable, status])
}

model ContentProgress {
  id             String              @id @default(uuid()) @db.Uuid
  contentId      String              @db.Uuid
  studentId      String              @db.Uuid
  state          ContentProgressState @default(NOT_STARTED)
  secondsWatched Int?
  completedAt    DateTime?

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contentId, studentId])
  @@index([studentId])
}

// ============================================================================
// AR / 3D LEARNING
// ============================================================================

enum ArModelFormat {
  GLB
  GLTF
  USDZ
}

enum ArValidationStatus {
  PENDING
  VALID
  WARNINGS
  INVALID
  INCOMPLETE
}

enum ArActivityType {
  AR_OPENED
  AR_STARTED
  AR_MODEL_INTERACTION
  AR_QUICK_CHECK_STARTED
  AR_QUICK_CHECK_COMPLETED
  AR_COMPLETED
}

model ArContent {
  id                String                 @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  learningObjective String?
  instructions      String?
  status            ContentLifecycleStatus @default(DRAFT)
  visibility        Visibility             @default(INSTITUTION_ONLY)
  difficulty        Difficulty             @default(MEDIUM)

  modelKey          String?
  modelUrl          String?
  modelFormat       ArModelFormat?
  fileSizeBytes     Int?
  previewKey        String?
  previewUrl        String?
  thumbnailUrl      String?
  hotspots          Json?

  polygonCount      Int?
  textureMaxDim     Int?
  validationStatus  ArValidationStatus      @default(PENDING)
  validationReport  Json?

  source            String?
  license           String?
  attribution       String?

  version           Int                    @default(1)

  institutionId     String?                @db.Uuid
  boardId           String?                @db.Uuid
  subjectId         String?                @db.Uuid
  chapterId         String?                @db.Uuid
  topicId           String?                @db.Uuid
  conceptId         String?                @db.Uuid
  grade             String?

  createdById       String?                @db.Uuid
  reviewedById      String?                @db.Uuid
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([conceptId, status])
  @@index([institutionId, status])
  @@index([status])
}

model ArContentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  arContentId String   @db.Uuid
  version     Int
  snapshot    Json
  modelKey    String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([arContentId])
}

model ArActivity {
  id            String         @id @default(uuid()) @db.Uuid
  type          ArActivityType
  arContentId   String         @db.Uuid
  conceptId     String?        @db.Uuid
  studentId     String?        @db.Uuid
  institutionId String?        @db.Uuid
  sessionId     String?
  metadata      Json?
  createdAt     DateTime       @default(now())

  @@index([arContentId, type])
  @@index([studentId])
  @@index([institutionId])
}

// ============================================================================
// QUESTION BANK
// ============================================================================

model Question {
  id            String         @id @default(uuid()) @db.Uuid
  institutionId String?        @db.Uuid
  boardId       String         @db.Uuid
  grade         String
  subjectId     String         @db.Uuid
  chapterId     String         @db.Uuid
  topicId       String?        @db.Uuid
  conceptId     String?        @db.Uuid
  type          QuestionType
  status        QuestionStatus @default(DRAFT)
  source        QuestionSource @default(MANUAL)
  difficulty    Difficulty     @default(MEDIUM)
  marks         Int?
  text          String
  hint          String?
  explanation   String?
  answer        String
  language      Language       @default(EN)
  createdById   String?        @db.Uuid
  aiGenerated   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  institution Institution?      @relation(fields: [institutionId], references: [id])
  board       Board             @relation(fields: [boardId], references: [id])
  subject     Subject           @relation(fields: [subjectId], references: [id])
  chapter     Chapter           @relation(fields: [chapterId], references: [id])
  topic       Topic?            @relation(fields: [topicId], references: [id])
  concept     Concept?          @relation(fields: [conceptId], references: [id])
  createdBy   User?             @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  options     QuestionOption[]
  mappings    QuestionConcept[]
  paperQuestions QuestionPaperQuestion[]
  assessmentQuestions AssessmentQuestion[]
  practiceAnswers PracticeAnswer[]
  flashcardRatings FlashcardRating[]

  @@index([institutionId])
  @@index([boardId, grade, subjectId, chapterId])
  @@index([status])
  @@index([conceptId])
}

model QuestionOption {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @db.Uuid
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuestionConcept {
  id          String   @id @default(uuid()) @db.Uuid
  questionId  String   @db.Uuid
  conceptId   String   @db.Uuid

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([questionId, conceptId])
  @@index([conceptId])
}

// ============================================================================
// QUESTION PAPERS
// ============================================================================

model QuestionPaper {
  id             String       @id @default(uuid()) @db.Uuid
  institutionId  String       @db.Uuid
  sourcePaperId  String?      @db.Uuid
  title          String
  examName       String
  boardId        String       @db.Uuid
  grade          String
  subjectId      String       @db.Uuid
  totalMarks     Int
  durationMinutes Int
  date           DateTime?
  instructions   String?
  language       Language     @default(EN)
  distribution   Json
  versionName    String?
  status         PaperStatus  @default(DRAFT)
  createdById    String       @db.Uuid
  exportedAt     DateTime?
  createdAt      DateTime     @default(now())

  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject       Subject              @relation(fields: [subjectId], references: [id])
  createdBy     User                 @relation("PaperCreatedBy", fields: [createdById], references: [id])
  questions     QuestionPaperQuestion[]
  sourcePaper   QuestionPaper?       @relation("PaperVersion", fields: [sourcePaperId], references: [id])
  versions      QuestionPaper[]      @relation("PaperVersion")
  assessments   Assessment[]

  @@index([institutionId])
  @@index([status])
  @@index([subjectId])
}

model QuestionPaperQuestion {
  id           String @id @default(uuid()) @db.Uuid
  paperId      String @db.Uuid
  questionId   String @db.Uuid
  sectionName  String
  sectionOrder Int
  order        Int
  marks        Int

  paper    QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id])

  @@unique([paperId, questionId])
  @@index([paperId, sectionOrder, order])
}

// ============================================================================
// ASSESSMENTS
// ============================================================================

model Assessment {
  id                String           @id @default(uuid()) @db.Uuid
  institutionId     String           @db.Uuid
  sourcePaperId     String?          @db.Uuid
  title             String
  subjectId         String?          @db.Uuid
  chapterId         String?          @db.Uuid
  totalMarks        Int
  durationMinutes   Int
  status            AssessmentStatus @default(DRAFT)
  mode              AssessmentMode   @default(DIGITAL)
  attemptsAllowed   Int              @default(1)
  teacherId         String?          @db.Uuid
  dueAt             DateTime?
  startsAt          DateTime?
  autoSubmitOnExpiry Boolean         @default(true)
  createdById       String           @db.Uuid
  createdAt         DateTime         @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject     Subject?    @relation(fields: [subjectId], references: [id])
  chapter     Chapter?    @relation(fields: [chapterId], references: [id])
  sourcePaper QuestionPaper? @relation(fields: [sourcePaperId], references: [id])
  createdBy   User        @relation("AssessmentCreatedBy", fields: [createdById], references: [id])
  teacher     Teacher?    @relation("AssessmentTeacher", fields: [teacherId], references: [id])
  questions   AssessmentQuestion[]
  assignments AssessmentAssignment[]
  attempts    AssessmentAttempt[]

  @@index([institutionId])
  @@index([status])
}

model AssessmentQuestion {
  id           String     @id @default(uuid()) @db.Uuid
  assessmentId String     @db.Uuid
  questionId   String?    @db.Uuid
  text         String
  type         QuestionType
  marks        Int
  answer       String?
  explanation  String?
  conceptId    String?    @db.Uuid
  options      Json
  order        Int

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question?          @relation(fields: [questionId], references: [id])
  answers    StudentAnswer[]

  @@index([assessmentId, order])
  @@index([conceptId])
}

model AssessmentAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @db.Uuid
  groupId      String?  @db.Uuid
  studentId    String   @db.Uuid
  assignedAt   DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  group      Group?     @relation("AssignmentGroup", fields: [groupId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model AssessmentAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  assessmentId  String        @db.Uuid
  studentId     String        @db.Uuid
  attemptIndex  Int           @default(1)
  status        AttemptStatus @default(NOT_STARTED)
  startedAt     DateTime?
  submittedAt   DateTime?
  score         Int?
  maxScore      Int?
  correctCount  Int?
  wrongCount    Int?
  skippedCount  Int?
  accuracy      Decimal?      @db.Decimal(5, 2)
  timeSpentSeconds Int?
  createdAt     DateTime      @default(now())

  assessment   Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      StudentAnswer[]
  diagnostics  DiagnosticResult[]

  @@unique([assessmentId, studentId, attemptIndex])
  @@index([studentId])
  @@index([status])
}

model StudentAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  attemptId      String   @db.Uuid
  assessmentQuestionId String @db.Uuid
  answer         String?
  isCorrect      Boolean?
  marksAwarded   Int?
  maxMarks       Int?
  gradedByTeacher Boolean @default(false)
  gradedById     String?  @db.Uuid
  gradedAt       DateTime?
  updatedAt      DateTime @updatedAt

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, assessmentQuestionId])
  @@index([attemptId])
}

// ============================================================================
// DIAGNOSIS / MASTERY / REMEDIATION / PRACTICE
// ============================================================================

model ConceptMastery {
  id          String      @id @default(uuid()) @db.Uuid
  studentId   String      @db.Uuid
  conceptId   String      @db.Uuid
  score       Int
  attempts    Int
  correct     Int
  evidenceCount Int
  level       MasteryLevel
  lastUpdatedAt DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentId, conceptId])
  @@index([studentId, level])
}

model DiagnosticResult {
  id          String      @id @default(uuid()) @db.Uuid
  studentId   String      @db.Uuid
  conceptId   String      @db.Uuid
  attemptId   String?     @db.Uuid
  practiceSetId String?   @db.Uuid
  score       Int
  attempts    Int
  correct     Int
  level       MasteryLevel
  evidence    String      @default("SUFFICIENT")
  createdAt   DateTime    @default(now())

  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  attempt AssessmentAttempt? @relation(fields: [attemptId], references: [id])
  practiceSet PracticeSet?  @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([conceptId, level])
  @@index([attemptId])
  @@index([practiceSetId])
}

model RemediationPlan {
  id          String              @id @default(uuid()) @db.Uuid
  studentId   String              @db.Uuid
  conceptId   String              @db.Uuid
  status      RemediationPlanStatus @default(ACTIVE)
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  completedAt DateTime?

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("PlanCreatedBy", fields: [createdById], references: [id])
  items    RemediationItem[]

  @@index([studentId])
  @@index([conceptId])
}

model RemediationItem {
  id          String               @id @default(uuid()) @db.Uuid
  planId      String               @db.Uuid
  order       Int
  contentType ContentType
  contentId   String?              @db.Uuid
  title       String
  status      RemediationItemStatus @default(PENDING)
  completedAt DateTime?

  plan    RemediationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  content ContentItem?    @relation(fields: [contentId], references: [id])

  @@index([planId])
}

model PracticeSet {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid
  conceptId    String?  @db.Uuid
  conceptIds   Json
  questionIds  Json
  status       String   @default("IN_PROGRESS")
  score        Int?
  total        Int?
  correctCount Int?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept?          @relation(fields: [conceptId], references: [id])
  answers PracticeAnswer[]
  diagnosticResults DiagnosticResult[]

  @@index([studentId])
  @@index([conceptId])
}

model PracticeAnswer {
  id           String   @id @default(uuid()) @db.Uuid
  practiceSetId String  @db.Uuid
  questionId   String   @db.Uuid
  answer       String?
  isCorrect    Boolean?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  practiceSet PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceSetId, questionId])
  @@index([practiceSetId])
}

/// Retired 2026-10-30: the student flashcard deck was removed (it replayed the
/// quiz pool without writing mastery evidence or XP). The table is kept so no
/// destructive migration is needed, and `generate-flashcards` authoring still
/// documents what it produced; nothing reads or writes it from the student flow.
model FlashcardRating {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @db.Uuid
  questionId String   @db.Uuid
  conceptId  String?  @db.Uuid
  rating     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept?  @relation(fields: [conceptId], references: [id])

  @@unique([studentId, questionId])
  @@index([studentId])
  @@index([conceptId])
}

// ============================================================================
// GAMIFICATION
// ============================================================================

model GamificationProfile {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid
  xp           Int      @default(0)
  streakDays   Int      @default(0)
  lastActiveAt DateTime?
  createdAt    DateTime @default(now())

  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId])
}

model XpEvent {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @db.Uuid
  xp        Int
  reason    String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model StudentAchievement {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid
  achievementId String  @db.Uuid
  unlockedAt   DateTime @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement  Achievement  @relation(fields: [achievementId], references: [id])

  @@unique([studentId, achievementId])
}

model Achievement {
  id       String @id @default(uuid()) @db.Uuid
  key      String @unique
  name     String
  description String?
  xp       Int    @default(0)
  icon     String?

  studentAchievements StudentAchievement[]
}

// ============================================================================
// IMPORTS
// ============================================================================

model ImportJob {
  id            String          @id @default(uuid()) @db.Uuid
  institutionId String          @db.Uuid
  academicYearId String         @db.Uuid
  entityType    ImportEntityType
  fileName      String
  originalName  String
  status        ImportStatus    @default(PENDING)
  totalRows     Int             @default(0)
  validRows     Int             @default(0)
  invalidRows   Int             @default(0)
  duplicateRows Int             @default(0)
  existingRows  Int             @default(0)
  importedRows  Int             @default(0)
  createdById   String          @db.Uuid
  errorReportPath String?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  institution  Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  createdBy    User        @relation(fields: [createdById], references: [id])
  rows         ImportRow[]

  @@index([institutionId])
}

model ImportRow {
  id        String        @id @default(uuid()) @db.Uuid
  jobId     String        @db.Uuid
  rowNumber Int
  name      String?
  status    ImportRowStatus
  errors    Json
  data      Json
  importedEntityId String? @db.Uuid

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @db.Uuid
  type        NotificationEventType
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String
  entityType  String?
  entityId    String?  @db.Uuid
  readAt      DateTime?
  createdAt   DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

// ============================================================================
// SUBSCRIPTIONS / PLANS
// ============================================================================

model Plan {
  id            String              @id @default(uuid()) @db.Uuid
  key           SubscriptionPlanKey @unique
  name          String
  priceMonthly  Int?
  priceYearly   Int?
  perSeat       Int                 @default(0)
  active        Boolean             @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  institutionId String?            @db.Uuid
  userId        String?            @db.Uuid
  planId        String             @db.Uuid
  status        SubscriptionStatus @default(TRIAL)
  startedAt     DateTime           @default(now())
  endsAt        DateTime?
  seatLimit     Int?
  createdAt     DateTime           @default(now())

  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user         User?        @relation("DirectSubscriptionOwner", fields: [userId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])
  history      SubscriptionHistory[]

  @@unique([userId])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([status])
  @@index([endsAt])
}

enum SubscriptionHistoryAction {
  CREATED
  UPDATED
  RENEWED
  PLAN_CHANGED
  LIMIT_CHANGED
  CANCELLED
  EXPIRED
  ACTIVATED
  SUSPENDED
}

model SubscriptionHistory {
  id             String               @id @default(uuid()) @db.Uuid
  institutionId  String?              @db.Uuid
  subscriptionId String?              @db.Uuid
  action         SubscriptionHistoryAction
  changedById    String               @db.Uuid
  oldPlanId      String?              @db.Uuid
  newPlanId      String?              @db.Uuid
  oldStatus      SubscriptionStatus?
  newStatus      SubscriptionStatus?
  oldSeatLimit   Int?
  newSeatLimit   Int?
  oldStartsAt    DateTime?
  oldEndsAt      DateTime?
  newStartsAt    DateTime?
  newEndsAt      DateTime?
  reason         String?
  createdAt      DateTime             @default(now())

  institution  Institution?  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  changedBy    User         @relation("SubscriptionHistoryChangedBy", fields: [changedById], references: [id])

  @@index([institutionId, createdAt])
  @@index([subscriptionId])
  @@index([action])
}

// ============================================================================
// REPORTS / SUPPORT / FILES / AUDIT
// ============================================================================

model Report {
  id            String     @id @default(uuid()) @db.Uuid
  institutionId String     @db.Uuid
  type          ReportType
  params        Json
  pdfUrl        String?
  generatedById String?    @db.Uuid
  createdAt     DateTime   @default(now())

  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
}

model SupportTicket {
  id            String              @id @default(uuid()) @db.Uuid
  institutionId String              @db.Uuid
  createdBy     String              @db.Uuid
  subject       String
  description   String
  status        SupportTicketStatus @default(OPEN)
  createdAt     DateTime            @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
}

enum ContentLifecycleStatus {
  DRAFT
  PROCESSING
  PROCESSED
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentSourceType {
  PDF_BOOK
  VIDEO
  NOTES
  WEBSITE
  YOUTUBE
}

enum ProcessingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentOwnerType {
  PLATFORM
  INSTITUTION
}

enum ContentProcessingStage {
  UPLOADED
  VALIDATING
  EXTRACTING
  OCR
  PARSING
  MAPPING
  CHUNKING
  EMBEDDING
  GENERATING
  REVIEW
  COMPLETED
  FAILED
  PARTIAL
}

model KnowledgeBase {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  sourceType  ContentSourceType
  sourceUrl   String?
  storageKey  String?
  ownerType   ContentOwnerType @default(INSTITUTION)
  institutionId String? @db.Uuid
  creatorId   String?   @db.Uuid
  status      ContentLifecycleStatus @default(DRAFT)
  stage       ContentProcessingStage @default(UPLOADED)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])
  creator     User?        @relation("KnowledgeBaseCreator", fields: [creatorId], references: [id])
  chunks      KnowledgeChunk[]
  jobs        ProcessingJob[]

  @@index([institutionId])
  @@index([status])
  @@index([ownerType, status])
}

model KnowledgeChunk {
  id              String  @id @default(uuid()) @db.Uuid
  knowledgeBaseId String  @db.Uuid
  content         String
  chapter         String?
  topic           String?
  concept         String?
  grade           String?
  subject         String?
  board           String?
  tokenCount      Int?
  sourcePage      Int?
  embedding       Json?
  metadata        Json?
  createdAt       DateTime @default(now())

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@index([grade, subject])
  @@index([board, grade, subject, chapter])
}

model ProcessingJob {
  id              String            @id @default(uuid()) @db.Uuid
  knowledgeBaseId String            @db.Uuid
  status          ProcessingJobStatus @default(PENDING)
  stage           ContentProcessingStage?
  inputType       String
  outputType      String?
  error           String?
  errorCode       String?
  metadata        Json?
  attempts        Int               @default(0)
  maxAttempts     Int               @default(3)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([stage])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  institutionId String?   @db.Uuid
  userId      String      @db.Uuid
  action      AuditAction
  entityType  String?
  entityId    String?     @db.Uuid
  metadata    Json
  createdAt   DateTime    @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([institutionId, createdAt])
  @@index([action])
}

model AiUsageLog {
  id            String        @id @default(uuid()) @db.Uuid
  institutionId String?       @db.Uuid
  userId        String        @db.Uuid
  operation     String
  model         String
  tokensIn      Int?
  tokensOut     Int?
  cost          Decimal?      @db.Decimal(10, 6)
  metadata      Json
  createdAt     DateTime      @default(now())

  @@index([institutionId, createdAt])
  @@index([userId])
}

model ContentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  contentId   String   @db.Uuid
  version     Int
  title       String
  description String?
  url         String?
  snapshot    Json
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, version])
  @@unique([contentId, version])
}

model ContentAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  contentId     String   @db.Uuid
  institutionId String   @db.Uuid
  assignedById  String?  @db.Uuid
  createdAt     DateTime @default(now())

  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([contentId, institutionId])
  @@index([contentId])
  @@index([institutionId])
  @@index([institutionId, createdAt])
}

model InstitutionCurriculumAccess {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  boardId       String   @db.Uuid
  grade         String?
  subjectId     String?  @db.Uuid
  grantedById   String?  @db.Uuid
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  board      Board        @relation(fields: [boardId], references: [id])
  subject    Subject?     @relation(fields: [subjectId], references: [id])

  @@unique([institutionId, boardId, grade, subjectId])
  @@index([institutionId])
  @@index([boardId])
  @@index([subjectId])
}

// ============================================================================
// WEBSITE / MARKETING LEADS
// ============================================================================

model ContactLead {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  role      String
  message   String
  source    String   @default("website")
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}