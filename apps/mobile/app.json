{
  "expo": {
    "name": "Sanro AI",
    "slug": "sanro-ai",
    "owner": "sanroai",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "sanro-ai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7c3aed"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanro.ai"
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#7c3aed",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.sanro.ai"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "eb098800-6294-4a77-ae94-fe34128a8364"
      }
    }
  }
}
