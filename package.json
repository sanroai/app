{
  "name": "sanro",
  "version": "0.1.0",
  "private": true,
  "description": "Sanro AI - academic intelligence and learning platform",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sanro/api db:generate",
    "db:migrate": "pnpm --filter @sanro/api db:migrate",
    "db:seed": "pnpm --filter @sanro/api db:seed",
    "db:seed:demo": "pnpm --filter @sanro/api db:seed:demo",
    "db:seed:qa": "pnpm --filter @sanro/api db:seed:qa",
    "reset-local-data": "pnpm --filter @sanro/api reset:local-data",
    "db:push": "pnpm --filter @sanro/api db:push",
    "books:extract": "node scripts/books/extract.cjs",
    "books:ocr": "node scripts/books/ocr.cjs",
    "books:index": "node scripts/books/build-index.cjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.25",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.13",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}