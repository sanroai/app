{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @sanro/api db:generate && pnpm --filter '@sanro/api...' run build"
  },
  "deploy": {
    "startCommand": "node apps/api/dist/main.js",
    "preDeployCommand": "pnpm --filter @sanro/api exec prisma migrate deploy",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 300
  }
}
}